{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "incremental": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "**/*.test.{ts,js,tsx,jsx}",
    "**/*.spec.{ts,js,tsx,jsx}"
  ]
}
